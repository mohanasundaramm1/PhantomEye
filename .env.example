# Kafka topic for the real CT lane: ct/ingest/forwarder.py -> ct/ingest/stream_ct.py.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=ct-events

# Certificate-Transparency-log websocket source for the real CT lane.
# Read by ct/ingest/forwarder.py. With the "certstream" service from
# docker-compose.yml running (host port 4000 -> container's lite endpoint
# at "/"), the default below is correct as-is.
CERTSTREAM_WS=ws://127.0.0.1:4000

# --- OSINT feeds / alerts (read by the Airflow scheduler) ---
# URLhaus now requires a free Auth-Key (the old public download URL returns 410 Gone).
# Create one at https://auth.abuse.ch/ and put it here. Never commit it.
URLHAUS_AUTH_KEY=
# Optional: push task-failure alerts to your phone via https://ntfy.sh/<topic>.
# The topic name acts as the secret: use a long random string. Leave empty to disable.
NTFY_TOPIC=
