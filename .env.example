# ----------------------------------------------------------------------------
# This repo runs TWO independent Kafka lanes on the SAME broker. They must
# NOT share a topic, or the synthetic lane's fake domains and the real CT
# lane's real domains end up mixed together on one topic.
#
#   1. SYNTHETIC DEMO LANE (schema-contract-validation testbed only --
#      does NOT feed the dashboard): simulator/producer.py ->
#      pipelines/spark_stream.py / pipelines/spark_stream_contract.py.
#      Topic default: "domain-events" (see simulator/producer.py,
#      pipelines/spark_stream.py).
#
#   2. REAL CT LANE (the project's actual real-time predictive pipeline):
#      ct/ingest/forwarder.py -> ct/ingest/stream_ct.py -> enrichment/scoring.
#      Topic default: "ct-events" (see ct/ingest/forwarder.py,
#      ct/ingest/stream_ct.py).
#
# KAFKA_TOPIC below is read by BOTH lanes' scripts. Whichever value you set
# here is the one that actually gets used -- so if you're running the real
# CT forwarder/stream_ct.py, make sure this stays "ct-events", NOT
# "domain-events" (the demo lane's topic). Mixing them up silently routes
# real or fake domains to the wrong consumer.
# ----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=ct-events
PRODUCER_RATE_SECS=1.0
PRODUCER_HEARTBEAT_SECS=30
SPARK_TRIGGER_SECS=5
BRONZE_DIR=./bronze/domain_events
DLQ_DIR=./dlq/bad_json
SPARK_CHECKPOINT_DIR=./chk/domain_events

# Certificate-Transparency-log websocket source for the real CT lane.
# Read by ct/ingest/forwarder.py. With the "certstream" service from
# docker-compose.yml running (host port 4000 -> container's lite endpoint
# at "/"), the default below is correct as-is.
CERTSTREAM_WS=ws://127.0.0.1:4000
